---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Sello from '../../components/Sello.astro';
import CapituloCard from '../../components/CapituloCard.astro';
import BloqueNumeros from '../../components/BloqueNumeros.astro';
import LeadForm from '../../components/LeadForm.astro';
import { capitulos } from '../../data/serie';
import { pesos, totalFijo, ventaNecesariaDia, ventaNecesariaMes } from '../../data/taqueria';

const publicados = new Set(
  (await getCollection('serie', (entrada) => !entrada.data.draft)).map((entrada) => entrada.id),
);

const capitulosOrdenados = [...capitulos].sort((a, b) => a.episodio - b.episodio);
const estaPublicado = (slug?: string) => Boolean(slug && publicados.has(slug));
const publicadosCount = capitulosOrdenados.filter((c) => estaPublicado(c.slug)).length;

const titulo = 'La taquería: el caso completo — Shua | soyshua.dev';
const descripcion = `Abrí mi taquería y la cerré en 3 días. Aquí está el caso completo con mis números reales: ${pesos(totalFijo)} de gastos fijos al mes y ${pesos(ventaNecesariaDia)} diarios solo para no perder.`;
---

<Layout title={titulo} description={descripcion}>
  <!-- Hero -->
  <section class="px-4 pb-4 pt-14 sm:px-6 sm:pt-20">
    <div class="mx-auto max-w-5xl">
      <Sello>Serie · Los de Caché</Sello>
      <h1
        class="mt-4 max-w-4xl font-mono text-[clamp(2rem,5vw,3.25rem)] font-bold leading-[1.15] tracking-tight text-ink [text-wrap:balance]"
      >
        Abrí mi taquería y la tuve que cerrar en 3 días.
      </h1>
      <p class="mt-6 max-w-[65ch] text-lg leading-relaxed text-ink-soft">
        Llevo años construyendo el software que los negocios usan para no quebrar. Abrí el mío y
        duró tres días. Aquí desarmo el caso completo, área por área, con mis números reales — para
        que si vas a abrir un negocio de comida, no cometas mis errores.
      </p>
      <p class="mt-5">
        <a
          href="/taqueria/abri-mi-taqueria-y-la-cerre-en-3-dias"
          class="font-mono text-sm font-medium text-brass transition-colors hover:text-ink"
        >
          Leer la historia completa →
        </a>
      </p>
    </div>
  </section>

  <!-- Los números reales: la sección que se muestra en pantalla -->
  <section class="px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="mb-3 h-0.5 w-10 bg-brass" aria-hidden="true"></div>
      <h2 class="font-mono text-[clamp(1.5rem,3.5vw,2.25rem)] font-bold tracking-tight text-ink">
        Mis números reales
      </h2>
      <p class="mt-3 max-w-[65ch] leading-relaxed text-ink-soft">
        Estos son los gastos fijos de Los de Caché. Sin redondear, sin quitarle lo incómodo. Son la
        base del punto de equilibrio: lo que necesito vender para no perder, antes de pagar un solo
        insumo.
      </p>

      <div class="mt-8">
        <BloqueNumeros nivelTitulo="h3" />
      </div>

      <p class="mt-8 max-w-[65ch] leading-relaxed text-ink-soft">
        El desglose de dónde sale cada cifra —incluida la comisión de tarjeta, que casi nadie
        cuenta— está en el
        <a
          href="/taqueria/punto-de-equilibrio-gastos-fijos-reales"
          class="font-medium text-brass underline underline-offset-4 transition-colors hover:text-ink"
          >episodio 1</a
        >.
      </p>
    </div>
  </section>

  <!-- Índice de la serie -->
  <section class="px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="mb-3 h-0.5 w-10 bg-brass" aria-hidden="true"></div>
      <h2 class="font-mono text-[clamp(1.5rem,3.5vw,2.25rem)] font-bold tracking-tight text-ink">
        Cómo iniciar un negocio gastronómico y no perder tus ahorros
      </h2>
      <p class="mt-3 max-w-[65ch] leading-relaxed text-ink-soft">
        {capitulosOrdenados.length} episodios, uno por área del negocio. {publicadosCount} publicados;
        el resto va saliendo. Cada uno tiene su video y su entrada aquí con los datos completos.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          capitulosOrdenados.map((capitulo) => (
            <CapituloCard
              capitulo={capitulo}
              publicado={estaPublicado(capitulo.slug)}
              nivelTitulo="h3"
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Suscripción -->
  <section class="px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="max-w-2xl">
        <LeadForm
          formId="suscripcion-taqueria"
          titulo="Te aviso cuando salga el siguiente episodio"
          texto={`Vamos por el punto de equilibrio: ${pesos(ventaNecesariaMes)} al mes. Faltan los insumos, los precios, las mermas y el resto. Sin spam, sin relleno.`}
        />
      </div>
    </div>
  </section>
</Layout>
