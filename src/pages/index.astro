---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Sello from '../components/Sello.astro';
import EntryCard from '../components/EntryCard.astro';
import ProximaCard from '../components/ProximaCard.astro';
import ResourceCard from '../components/ResourceCard.astro';
import LeadForm from '../components/LeadForm.astro';
import { pilares } from '../data/pilares';
import { recursos } from '../data/recursos';
import { numeroDePieza, proximamente } from '../data/bitacora';
import { pesos, totalFijo, ventaNecesariaDia } from '../data/taqueria';
import { losDeCache, reelDeArranque } from '../data/redes';
import { capitulos } from '../data/serie';
import fotoShua from '../img/shua-taqueria.jpg';

const entradas = (await getCollection('bitacora', (entrada) => !entrada.data.draft)).sort(
  (a, b) =>
    b.data.fecha.getTime() - a.data.fecha.getTime() ||
    (numeroDePieza[b.id] ?? '').localeCompare(numeroDePieza[a.id] ?? ''),
);
const recientes = entradas.slice(0, 3);
const [recursoDestacado] = recursos;

const episodiosPublicados = (await getCollection('serie', (entrada) => !entrada.data.draft)).length;
---

<Layout>
  <!-- Hero -->
  <section class="px-4 pb-4 pt-14 sm:px-6 sm:pt-20">
    <div class="mx-auto max-w-5xl">
      <Sello>soyshua.dev · Build in public</Sello>
      <h1
        class="mt-4 max-w-4xl font-mono text-[clamp(2rem,5vw,3.25rem)] font-bold leading-[1.15] tracking-tight text-ink [text-wrap:balance]"
      >
        Construyo negocios de software y anoto todo lo que aprendo en el camino.
      </h1>
      <p class="mt-6 max-w-[65ch] text-lg leading-relaxed text-ink-soft">
        Soy Shua — cofundador y CMO en Aztecknology. Esta es mi bitácora de taller: aquí documento
        cómo aplico ideas de oferta, marketing, copywriting y crecimiento a decisiones reales.
        Precios de Nei Digital, sistemas con IA, y el oficio de vender sin traicionar el producto.
      </p>
    </div>
  </section>

  <!-- La taquería: la serie -->
  <section class="px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="mb-3 h-0.5 w-10 bg-brass" aria-hidden="true"></div>
      <div class="grid gap-8 md:grid-cols-[1fr_300px] md:gap-12">
        <div>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <Sello>Serie en curso · {losDeCache.nombre}</Sello>
            <Sello variante="tenue">
              {episodiosPublicados} de {capitulos.length} episodios
            </Sello>
          </div>
          <h2
            class="mt-3 font-mono text-[clamp(1.5rem,3.5vw,2.25rem)] font-bold leading-snug tracking-tight text-ink [text-wrap:balance]"
          >
            Abrí mi taquería y la tuve que cerrar en 3 días
          </h2>
          <p class="mt-4 max-w-[60ch] leading-relaxed text-ink-soft">
            Llevo años construyendo el software que los negocios usan para no quebrar. Abrí el mío
            y duró tres días. Cerré antes de irme a la quiebra, en lugar de aguantar perdiendo.
            Sigue cerrada: reabre cuando los números cierren, no antes.
          </p>
          <p class="mt-3 max-w-[60ch] leading-relaxed text-ink-soft">
            Estoy desarmando el caso completo, área por área, con mis números reales. Sin
            redondear y sin quitarle lo incómodo.
          </p>

          <dl class="mt-7 grid grid-cols-3 gap-4 border-y border-rule py-5">
            <div>
              <dt class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-soft">
                Duré abierto
              </dt>
              <dd
                class="mt-1 font-mono text-[clamp(1.15rem,3.5vw,1.6rem)] font-bold leading-none tabular-nums text-ink"
              >
                3 días
              </dd>
            </div>
            <div>
              <dt class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-soft">
                Gasto fijo/mes
              </dt>
              <dd
                class="mt-1 font-mono text-[clamp(1.15rem,3.5vw,1.6rem)] font-bold leading-none tabular-nums text-ink"
              >
                {pesos(totalFijo)}
              </dd>
            </div>
            <div>
              <dt class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-soft">
                Para no perder
              </dt>
              <dd
                class="mt-1 font-mono text-[clamp(1.15rem,3.5vw,1.6rem)] font-bold leading-none tabular-nums text-brass"
              >
                {pesos(ventaNecesariaDia)}<span class="text-sm font-normal">/día</span>
              </dd>
            </div>
          </dl>

          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a
              href="/taqueria"
              class="rounded-[2px] bg-brass px-5 py-2.5 font-mono text-sm font-bold text-card transition-colors hover:bg-ink"
            >
              Ver el caso completo →
            </a>
            <a
              href={reelDeArranque}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-sm font-medium text-brass transition-colors hover:text-ink"
            >
              Ver el reel →
            </a>
            <a
              href={losDeCache.sitio}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-sm font-medium text-brass transition-colors hover:text-ink"
            >
              Conocer {losDeCache.nombre} →
            </a>
          </div>
        </div>

        <figure class="ficha mx-auto w-full max-w-[300px] self-start p-3">
          <Image
            src={fotoShua}
            alt="Shua en la terraza de Los de Caché, en Ladrón de Guevara, Guadalajara"
            width={300}
            height={375}
            widths={[300, 600]}
            sizes="(max-width: 768px) 300px, 300px"
            class="aspect-[4/5] w-full border border-rule object-cover"
            loading="eager"
          />
          <figcaption class="mt-3 font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-soft">
            {losDeCache.nombre} · {losDeCache.estado}
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Los 5 pilares -->
  <section class="px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="mb-3 h-0.5 w-10 bg-brass" aria-hidden="true"></div>
      <h2 class="font-mono text-[clamp(1.5rem,3.5vw,2.25rem)] font-bold tracking-tight text-ink">
        De dónde salen las notas
      </h2>
      <p class="mt-3 max-w-[65ch] leading-relaxed text-ink-soft">
        No escribo teoría suelta. Cada nota conecta una idea de alguien que sabe con una decisión
        que estoy tomando en un negocio real.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          pilares.map((pilar) => (
            <article class="ficha p-5 sm:p-6">
              <Sello>{pilar.referente}</Sello>
              <h3 class="mt-2 font-mono text-base font-bold tracking-tight text-ink">
                {pilar.nombre}
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{pilar.descripcion}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- En la bitácora -->
  <section class="px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="mb-3 h-0.5 w-10 bg-brass" aria-hidden="true"></div>
      <h2 class="font-mono text-[clamp(1.5rem,3.5vw,2.25rem)] font-bold tracking-tight text-ink">
        En la bitácora
      </h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          recientes.map((entrada) => (
            <EntryCard
              slug={entrada.id}
              titulo={entrada.data.title}
              resumen={entrada.data.resumen}
              fecha={entrada.data.fecha}
              pilar={entrada.data.pilar}
              numero={numeroDePieza[entrada.id]}
            />
          ))
        }
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {proximamente.map((pieza) => <ProximaCard pieza={pieza} />)}
      </div>
      <p class="mt-6">
        <a
          href="/bitacora"
          class="font-mono text-sm font-medium text-brass transition-colors hover:text-ink"
        >
          Ver toda la bitácora →
        </a>
      </p>
    </div>
  </section>

  <!-- Recurso destacado -->
  <section class="px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="mb-3 h-0.5 w-10 bg-brass" aria-hidden="true"></div>
      <h2 class="font-mono text-[clamp(1.5rem,3.5vw,2.25rem)] font-bold tracking-tight text-ink">
        Herramientas que hice y comparto
      </h2>
      <div class="mt-8 max-w-2xl">
        <ResourceCard recurso={recursoDestacado} />
      </div>
      <p class="mt-6">
        <a
          href="/recursos"
          class="font-mono text-sm font-medium text-brass transition-colors hover:text-ink"
        >
          Ver todos los recursos →
        </a>
      </p>
    </div>
  </section>

  <!-- Suscripción -->
  <section class="px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl">
      <div class="max-w-2xl">
        <LeadForm formId="suscripcion-inicio" />
      </div>
    </div>
  </section>

  <!-- Sobre mí (teaser) -->
  <section class="px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto max-w-5xl border-t border-rule pt-10">
      <Sello>Sobre mí</Sello>
      <p class="mt-3 max-w-[65ch] text-lg leading-relaxed text-ink">
        No empecé en marketing: empecé escribiendo código. Hoy soy cofundador y CMO en
        Aztecknology, y esta bitácora es donde comparto lo que voy aprendiendo mientras construyo.
        Si te sirve, tómalo.
      </p>
      <p class="mt-4">
        <a
          href="/sobre-mi"
          class="font-mono text-sm font-medium text-brass transition-colors hover:text-ink"
        >
          Conóceme →
        </a>
      </p>
    </div>
  </section>
</Layout>
