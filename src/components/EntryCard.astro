---
import Sello from './Sello.astro';
import { nombreDePilar } from '../data/pilares';
import { formatearFecha } from '../lib/fecha';

interface Props {
  slug: string;
  titulo: string;
  resumen: string;
  fecha: Date;
  pilar: string;
  numero?: string;
  nivelTitulo?: 'h2' | 'h3';
}

const { slug, titulo, resumen, fecha, pilar, numero, nivelTitulo: Titulo = 'h3' } = Astro.props;
---

<article class="ficha group relative p-6 transition-colors hover:border-brass sm:p-7">
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <Sello>{numero ? `${numero} · ` : ''}{nombreDePilar(pilar)}</Sello>
    <Sello variante="tenue">{formatearFecha(fecha)}</Sello>
  </div>
  <Titulo class="mt-3 font-mono text-lg font-bold leading-snug tracking-tight text-ink sm:text-xl">
    <a
      href={`/bitacora/${slug}`}
      class="transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-brass"
    >
      {titulo}
    </a>
  </Titulo>
  <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-soft">{resumen}</p>
</article>
