---
interface Props {
  variante?: 'brass' | 'relleno' | 'tenue' | 'contorno' | 'moss';
  class?: string;
}

const { variante = 'brass', class: claseExtra = '' } = Astro.props;

const variantes: Record<string, string> = {
  brass: 'text-brass',
  relleno: 'bg-brass px-2 py-0.5 text-card',
  tenue: 'text-ink-soft',
  contorno: 'border border-rule px-2 py-0.5 text-ink-soft',
  moss: 'text-moss',
};
---

<span
  class={`inline-block font-mono text-[0.6875rem] uppercase tracking-[0.1em] ${variantes[variante]} ${claseExtra}`}
>
  <slot />
</span>
